# Copy to backend/.env and fill in. Real environment variables take precedence.

# Server-side Google Maps Platform key with the Routes API enabled.
# Restrict it to the Routes API in the Cloud console and never ship it to the browser.
GOOGLE_MAPS_API_KEY=

# record (default): serve from cache, call Google on a miss and save the answer.
# replay: cache only, zero API calls; a miss is an error. Use on the expo floor.
# off: always call Google, never cache.
ROUTES_CACHE_MODE=record

# Relative paths resolve against backend/.
# ROUTES_CACHE_DIR=.cache/routes
# ROUTES_CACHE_MAX_AGE_DAYS=30

# Traffic-aware routing bills at the Pro SKU, which has a smaller free allowance.
# Leave off unless you need the traffic term in the score.
ROUTES_TRAFFIC_AWARE=false

# Two-letter country used when a trip doesn't say. It decides which turns cross
# oncoming traffic (lefts in the US, rights in the UK). Unset means keep-right.
# ROUTES_DEFAULT_COUNTRY=US

# Optional CSV of recorded crashes (lat,lng[,crashes]) for crash-prone junctions.
# For Milwaukee: python -m app.crash_data milwaukee-metro (fatal crashes, NHTSA FARS).
# ROUTES_CRASH_DATA=data/crashes/milwaukee-metro.csv
# Crashes within 35 m of a junction needed to call it crash-prone: 1 for fatal-only
# data like FARS; raise it for datasets of all crashes covering many years.
# ROUTES_CRASH_MIN_COUNT=1

# The web map: google (Google's map, live traffic; shows Google's logo) or osm
# (OpenStreetMap, no logo, no Google calls at all; live traffic from TomTom and 511).
# ROUTES_MAP=google

# When school zones count (local time, weekdays, outside July and August).
# ROUTES_SCHOOL_HOURS=07:00-09:00,14:00-16:30

# What a gallon of gas costs (US dollars), for each route's fuel cost on the page.
# ROUTES_FUEL_PRICE=3.25

# National Weather Service alerts where each trip starts (free, no key). off to skip.
# ROUTES_WEATHER_ALERTS=on

# Bus routes on the OpenStreetMap map's Transit layer: Milwaukee County Transit System's
# GTFS feed by default; off for none, or another feed's address.
# ROUTES_BUS_ROUTES=off

# For a demo shared over a public link: route requests must carry this code
# (the page takes it from ?code=... in the link). Leave unset on localhost.
# ROUTES_ACCESS_CODE=

# Road graph for the engine's own router. Build it with: python -m app.build_graph milwaukee-metro
# ROUTES_GRAPH=data/graphs/milwaukee-metro.json.gz
# In record mode, live-traffic answers older than this are fetched again.
# ROUTES_TRAFFIC_FRESH_MINUTES=5

# Local cap on live Google requests per day (counted in the cache folder). 0 = no cap.
# A router-mode trip uses up to 4; raise this for the expo.
ROUTES_DAILY_LIMIT=150

# Extra browser origins allowed to call the API (comma-separated). Pages on localhost are always allowed.
# ROUTES_CORS_ORIGINS=https://my-demo.example

# Road events (closures, lane closures, jams): where they come from, in order of
# preference. A trip uses the first that is set up and answers; the rest are
# backups. "a+b" uses a and b together.
#   wzdx    Wisconsin's Work Zone Data Exchange feed (public, no key): work zones
#   wi511   Wisconsin DOT's 511 feed (official; free key, see README): incidents too
#   tomtom  TomTom's traffic on every street: jams, closures, lane closures, crashes
#           (free plan; key below). The OpenStreetMap map only.
#   google  traffic speeds along Google's own suggestions (no new account; billed
#           at a higher Routes tier; slowdowns only; needs live traffic). Google's map only.
#   apify   scraped Google Maps traffic tiles (paid per tile; against Google's
#           terms, which risks the Google keys). Only used when listed here.
ROUTES_ROAD_EVENT_SOURCES=wzdx+wi511+tomtom,google
# A saved copy of the WZDx feed to read instead of the live one (for an offline demo).
# ROUTES_WZDX_FILE=data/wzdx.json
# Developer key from 511wi.gov (Wisconsin 511), emailed once approved.
WI511_API_KEY=
# API key from developer.tomtom.com (free plan: 2,500 incident requests and
# 200,000 traffic tiles a month). Kept on the server; the page's traffic map
# comes through it. The daily caps below keep a month inside the free plan.
TOMTOM_API_KEY=
# ROUTES_TOMTOM_DAILY_REQUESTS=80
# ROUTES_TOMTOM_DAILY_TILES=6000
# Apify API token, for the apify source only (Apify Console > Settings > Integrations).
# APIFY_TOKEN=
# Traffic tiles per day the apify source may fetch (a trip uses up to 81).
# ROUTES_APIFY_DAILY_TILES=300
